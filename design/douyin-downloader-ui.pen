{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "app-shell",
      "x": 0,
      "y": 0,
      "name": "App Shell",
      "clip": true,
      "width": 1200,
      "height": 800,
      "fill": "$color/bg",
      "children": [
        {
          "type": "frame",
          "id": "sidebar",
          "name": "Sidebar",
          "width": 240,
          "height": 800,
          "fill": "$color/surface",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "frame",
              "id": "sidebar-logo",
              "name": "Logo",
              "gap": 10,
              "children": [
                {
                  "type": "icon",
                  "id": "logo-icon",
                  "name": "Logo Icon",
                  "width": 28,
                  "height": 28,
                  "icon": "download",
                  "library": "lucide",
                  "fill": "$color/accent"
                },
                {
                  "type": "text",
                  "id": "logo-text",
                  "name": "Logo Text",
                  "fill": "$color/text",
                  "content": "抖音下载器",
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "nav-section",
              "name": "Navigation",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "type": "text",
                  "id": "nav-label",
                  "name": "NAV LABEL",
                  "fill": "$color/text-muted",
                  "content": "导航",
                  "fontFamily": "Inter",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "nav-download",
                  "name": "Nav - Download",
                  "fill": "$color/accent",
                  "cornerRadius": 8,
                  "gap": 10,
                  "children": [
                    {
                      "type": "icon",
                      "id": "nav-download-icon",
                      "width": 18,
                      "height": 18,
                      "icon": "arrow-down-to-line",
                      "library": "lucide",
                      "fill": "#FFFFFF"
                    },
                    {
                      "type": "text",
                      "id": "nav-download-text",
                      "fill": "#FFFFFF",
                      "content": "下载",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "nav-merge",
                  "name": "Nav - Merge",
                  "fill": "transparent",
                  "cornerRadius": 8,
                  "gap": 10,
                  "children": [
                    {
                      "type": "icon",
                      "id": "nav-merge-icon",
                      "width": 18,
                      "height": 18,
                      "icon": "git-merge",
                      "library": "lucide",
                      "fill": "$color/text-muted"
                    },
                    {
                      "type": "text",
                      "id": "nav-merge-text",
                      "fill": "$color/text-muted",
                      "content": "文件合并",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "nav-settings",
                  "name": "Nav - Settings",
                  "fill": "transparent",
                  "cornerRadius": 8,
                  "gap": 10,
                  "children": [
                    {
                      "type": "icon",
                      "id": "nav-settings-icon",
                      "width": 18,
                      "height": 18,
                      "icon": "settings",
                      "library": "lucide",
                      "fill": "$color/text-muted"
                    },
                    {
                      "type": "text",
                      "id": "nav-settings-text",
                      "fill": "$color/text-muted",
                      "content": "设置",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "nav-sync",
                  "name": "Nav - Sync",
                  "fill": "transparent",
                  "cornerRadius": 8,
                  "gap": 10,
                  "children": [
                    {
                      "type": "icon",
                      "id": "nav-sync-icon",
                      "width": 18,
                      "height": 18,
                      "icon": "refresh-cw",
                      "library": "lucide",
                      "fill": "$color/text-muted"
                    },
                    {
                      "type": "text",
                      "id": "nav-sync-text",
                      "fill": "$color/text-muted",
                      "content": "仓库同步",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "sidebar-spacer",
              "width": 216,
              "height": 100,
              "layout": "vertical"
            },
            {
              "type": "frame",
              "id": "sidebar-status",
              "name": "Status",
              "fill": "$color/input-bg",
              "cornerRadius": 8,
              "gap": 8,
              "children": [
                {
                  "type": "frame",
                  "id": "status-dot",
                  "width": 8,
                  "height": 8,
                  "fill": "$color/success",
                  "cornerRadius": 4
                },
                {
                  "type": "text",
                  "id": "status-text",
                  "fill": "$color/text-muted",
                  "content": "服务运行中",
                  "fontFamily": "Inter",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "main-content",
          "name": "Main Content",
          "width": 960,
          "height": 800,
          "layout": "vertical",
          "children": [
            {
              "type": "frame",
              "id": "page-header",
              "name": "Page Header",
              "children": [
                {
                  "type": "text",
                  "id": "page-title",
                  "fill": "$color/text",
                  "content": "下载",
                  "fontFamily": "Inter",
                  "fontSize": 22,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "page-content",
              "name": "Page Content",
              "layout": "vertical",
              "gap": 20,
              "children": [
                {
                  "type": "frame",
                  "id": "card-download",
                  "name": "Download Card",
                  "fill": "$color/surface",
                  "cornerRadius": 12,
                  "stroke": "$color/border",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "card-download-title",
                      "fill": "$color/text",
                      "content": "新建下载任务",
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "row-url",
                      "name": "URL Input Row",
                      "gap": 10,
                      "children": [
                        {
                          "type": "frame",
                          "id": "input-url-wrapper",
                          "name": "URL Input",
                          "width": 520,
                          "height": 40,
                          "fill": "$color/input-bg",
                          "cornerRadius": 8,
                          "stroke": "$color/border",
                          "strokeWidth": 1,
                          "gap": 8,
                          "children": [
                            {
                              "type": "icon",
                              "id": "input-url-icon",
                              "width": 16,
                              "height": 16,
                              "icon": "link",
                              "library": "lucide",
                              "fill": "$color/text-muted"
                            },
                            {
                              "type": "text",
                              "id": "input-url-placeholder",
                              "fill": "$color/text-muted",
                              "content": "粘贴抖音链接...",
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "btn-paste",
                          "name": "Paste Button",
                          "fill": "$color/input-bg",
                          "cornerRadius": 8,
                          "stroke": "$color/border",
                          "strokeWidth": 1,
                          "gap": 6,
                          "children": [
                            {
                              "type": "icon",
                              "id": "btn-paste-icon",
                              "width": 14,
                              "height": 14,
                              "icon": "clipboard-paste",
                              "library": "lucide",
                              "fill": "$color/text-muted"
                            },
                            {
                              "type": "text",
                              "id": "btn-paste-text",
                              "fill": "$color/text-muted",
                              "content": "粘贴",
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "btn-start",
                          "name": "Start Button",
                          "fill": "$color/accent",
                          "cornerRadius": 8,
                          "gap": 6,
                          "children": [
                            {
                              "type": "icon",
                              "id": "btn-start-icon",
                              "width": 14,
                              "height": 14,
                              "icon": "play",
                              "library": "lucide",
                              "fill": "#FFFFFF"
                            },
                            {
                              "type": "text",
                              "id": "btn-start-text",
                              "fill": "#FFFFFF",
                              "content": "开始下载",
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "row-options",
